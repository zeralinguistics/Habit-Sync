<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Dark from the first frame: no white flash before the app paints. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#05070D</item>
        <item name="colorPrimaryDark">#05070D</item>
        <item name="colorAccent">#3AA8FF</item>
        <item name="android:windowBackground">#05070D</item>
        <item name="android:statusBarColor">#05070D</item>
        <item name="android:navigationBarColor">#05070D</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">#05070D</item>
        <item name="android:statusBarColor">#05070D</item>
        <item name="android:navigationBarColor">#05070D</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
